{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": ["**/hieradata/**"],
  "labels": ["enhancement"],
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "matchManagers": ["puppet"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "schedule": ["on monday"]
    }
  ]
}
