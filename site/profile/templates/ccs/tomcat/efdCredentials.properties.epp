<%- | Sensitive[String[1]] $user,
      Sensitive[String[1]] $pass,
      String[1] $url,
      String[1] $namespace,
| -%>
# This file is managed by Puppet; changes may be overwritten
org.lsst.ccs.efd.username = <%= $user %>
org.lsst.ccs.efd.password = <%= $pass %>
org.lsst.ccs.efd.url = <%= $url %>
org.lsst.ccs.efd.namespace = <%= $namespace %>
